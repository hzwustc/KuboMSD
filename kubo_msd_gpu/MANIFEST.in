include LICENSE
include README.md CHANGELOG.md CONTRIBUTING.md
include pyproject.toml setup.py MANIFEST.in constraints-tested.txt env-gpu.sh
include .gitignore .gitattributes
recursive-include .github *.yml
recursive-include src/kubo_msd *.py *.cu
recursive-include docs *.md
recursive-include tests *.py *.npz
recursive-include examples *.md *.json *.npz *.h5 *.orb
include examples/raw_lcao/POSCAR
recursive-include scripts *.py *.sh *.slurm
include benchmarks/benchmark_transport.py benchmarks/validate_tolerance.py
global-exclude __pycache__ *.py[cod] *.so
prune validation
prune runs
prune local_data
prune .venv
prune .venv-wheel
